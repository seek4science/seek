# Example environment variables for local OIDC demos
# Copy to .env and edit. Used with docker-compose.override.yml.example.
#
# Production: prefer Admin → OmniAuth / group settings. SEEK does not require these ENV vars.

# ---------------------------------------------------------------------------
# OmniAuth / OIDC
# ---------------------------------------------------------------------------
OMNIAUTH_ENABLED=true
OMNIAUTH_OIDC_ENABLED=true
OMNIAUTH_OIDC_NAME=SRAM
OMNIAUTH_OIDC_ISSUER=https://your-provider.example/realms/your-realm
OMNIAUTH_OIDC_CLIENT_ID=your-client-id
OMNIAUTH_OIDC_SECRET=your-client-secret

# Redirect URI is derived from Admin → site_base_host:
#   {site_base_host}/auth/oidc/callback
# Register that URI at the IdP. SEEK does not read OMNIAUTH_OIDC_REDIRECT_URI.

# Include any scope needed for group claims (e.g. entitlement).
OMNIAUTH_OIDC_SCOPE=openid email profile entitlement

# ---------------------------------------------------------------------------
# Group claim → Project sync (also configurable in Admin; default off in stock SEEK)
# ---------------------------------------------------------------------------
OMNIAUTH_OIDC_GROUPS_ENABLED=true
# Examples: entitlement | groups | realm_access.roles
OMNIAUTH_OIDC_GROUPS=entitlement

# ---------------------------------------------------------------------------
# Default Institution (local oidc_setup.rb overlay only)
# ---------------------------------------------------------------------------
OMNIAUTH_OIDC_DEFAULT_INSTITUTION=Default Institution
OMNIAUTH_OIDC_DEFAULT_INSTITUTION_COUNTRY=NL
OMNIAUTH_OIDC_DEFAULT_INSTITUTION_CITY=
OMNIAUTH_OIDC_DEFAULT_INSTITUTION_WEB=
